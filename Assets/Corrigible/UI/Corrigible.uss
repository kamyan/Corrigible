/* Kriz masası: koyu zemin, ince çizgiler; renk yalnızca tehlike, doğrulama ve uyarı anlamı taşır. Tarayıcı prototipiyle aynı paletler. */
:root {
    --bg: #0a1114;
    --panel: #10191e;
    --raise: #16232a;
    --line: #22343c;
    --line2: #2f4650;
    --fg: #d6e1e3;
    --muted: #7f949b;
    --dim: #56707a;
    --threat: #ff5b4d;
    --verify: #5cc8d9;
    --warn: #f0b03f;
    --good: #6cc995;
    --ink-on-threat: #1d0b08;
}

.root { flex-grow: 1; background-color: var(--bg); padding: 12px 16px; color: var(--fg); font-size: 14px; }
.row { flex-direction: row; align-items: center; }
.grow { flex-grow: 1; flex-shrink: 1; }
.muted { color: var(--muted); }
.dim { color: var(--dim); }
.mono { -unity-font-style: normal; }
.bold { -unity-font-style: bold; }
.threat { color: var(--threat); }
.verify { color: var(--verify); }
.warn { color: var(--warn); }
.good { color: var(--good); }
Label { white-space: normal; margin: 0; padding: 0; }

.card { background-color: var(--panel); border-width: 1px; border-color: var(--line); border-radius: 8px; }

/* Üst şerit */
.top { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.brand { font-size: 24px; -unity-font-style: bold; letter-spacing: 6px; margin-right: 14px; }
.brand-sub { font-size: 12px; color: var(--muted); letter-spacing: 1px; }
.day { font-size: 19px; -unity-font-style: bold; margin-right: 14px; letter-spacing: 1px; }
.day.glitch { color: var(--threat); translate: 3px 0; }
.speed { flex-direction: row; border-width: 1px; border-color: var(--line2); border-radius: 6px; overflow: hidden; }
.speed Button { margin: 0; border-width: 0; border-radius: 0; background-color: rgba(0,0,0,0); color: var(--muted); padding: 6px 12px; font-size: 13px; }
.speed Button.on { background-color: var(--raise); color: var(--fg); }

/* Göstergeler */
.gauges { flex-direction: row; margin-bottom: 10px; }
.gauge { flex-grow: 1; flex-basis: 0; background-color: var(--panel); border-width: 1px; border-color: var(--line); padding: 10px 14px 12px; margin-right: -1px; }
.gauge-lab { flex-direction: row; justify-content: space-between; }
.gauge-lab Label { font-size: 11px; color: var(--muted); letter-spacing: 1px; }
.gauge-note { color: var(--dim); letter-spacing: 0; }
.gauge-val { font-size: 22px; -unity-font-style: bold; margin: 4px 0 6px; }
.bar { height: 6px; background-color: var(--raise); border-radius: 3px; }
.bar-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 3px; background-color: var(--fg); }
.notch { position: absolute; top: -3px; bottom: -3px; width: 1px; background-color: var(--muted); }
.notch.silent { background-color: var(--threat); }

/* Danışman */
.advisor { flex-direction: row; align-items: center; background-color: var(--panel); border-width: 1px; border-color: var(--line2); border-left-width: 3px; border-left-color: var(--verify); border-radius: 6px; padding: 8px 12px; margin-bottom: 10px; }
.advisor-who { color: var(--verify); -unity-font-style: bold; font-size: 11px; letter-spacing: 2px; margin-right: 12px; }

/* Ana ızgara */
.main { flex-direction: row; flex-grow: 1; flex-shrink: 1; margin-bottom: 10px; }
.mapcard { flex-grow: 1; flex-shrink: 1; padding: 8px; margin-right: 12px; }
.side { width: 400px; flex-shrink: 0; }
.side .card { flex-shrink: 0; }
.side .unity-scroll-view__content-container { padding-right: 6px; }

/* Harita */
.map { position: relative; width: 100%; overflow: hidden; }
.map-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.map-name { position: absolute; color: var(--fg); -unity-font-style: bold; font-size: 12px; white-space: nowrap; text-shadow: 0 0 3px #0a1114; }
.map-sub { position: absolute; font-size: 10px; white-space: nowrap; letter-spacing: 1px; text-shadow: 0 0 3px #0a1114; }
.map-val { position: absolute; font-size: 12px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: nowrap; }
.map-val.report { -unity-font-style: italic; }
.map-badge { position: absolute; width: 15px; height: 15px; border-radius: 8px; -unity-text-align: middle-center; font-size: 9px; -unity-font-style: bold; color: var(--bg); }
.map-lat { position: absolute; color: var(--dim); font-size: 10px; }
.legend { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.legend Label { color: var(--muted); font-size: 12px; margin-right: 16px; margin-top: 2px; }

/* Bölge paneli */
.region { padding: 14px; margin-bottom: 10px; }
.region-head { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.region-name { font-size: 20px; -unity-font-style: bold; }
.region-ll { font-size: 12px; color: var(--muted); margin-top: 2px; }
.chips { flex-direction: row; flex-wrap: wrap; justify-content: flex-end; max-width: 190px; }
.chip { font-size: 10px; letter-spacing: 1px; padding: 2px 8px; border-radius: 10px; border-width: 1px; border-color: var(--line2); color: var(--muted); margin-left: 4px; margin-bottom: 4px; }
.chip.q { color: var(--warn); border-color: var(--warn); }
.chip.off { color: var(--threat); border-color: var(--threat); }
.chip.core { color: var(--threat); border-color: var(--threat); }
.chip.obs { color: var(--verify); border-color: var(--verify); }
.inf { flex-direction: row; align-items: center; background-color: var(--raise); border-radius: 6px; padding: 10px 12px; margin-top: 12px; }
.inf-big { font-size: 34px; -unity-font-style: bold; min-width: 70px; }
.inf-big.report { -unity-font-style: italic; color: var(--muted); }
.inf-src { font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; color: var(--muted); }
.inf-src.verified { color: var(--verify); }
.inf-src.suspect { color: var(--warn); }
.inf-note { font-size: 12px; color: var(--muted); }
.stats { flex-direction: row; margin-top: 12px; }
.stat { flex-grow: 1; flex-basis: 0; }
.stat-k { font-size: 11px; color: var(--muted); letter-spacing: 1px; }
.stat-v { font-size: 16px; -unity-font-style: bold; }
.stat-s { font-size: 11px; color: var(--muted); }
.actions { flex-direction: row; flex-wrap: wrap; margin-top: 12px; justify-content: space-between; }
.act { width: 49%; margin: 0 0 8px 0; padding: 8px 10px; background-color: var(--raise); border-width: 1px; border-color: var(--line2); border-radius: 6px; -unity-text-align: upper-left; color: var(--fg); }
.act:hover { border-color: var(--verify); }
.act:disabled { opacity: 0.42; }
.act.kill { width: 100%; border-color: #8a3c35; }
.act-t { -unity-font-style: bold; font-size: 13px; }
.act-s { font-size: 11px; color: var(--muted); }
.act-s.short { color: var(--threat); }

/* Sekmeler */
.tabs { flex-direction: row; border-bottom-width: 1px; border-color: var(--line); }
.tab { flex-grow: 1; margin: 0; border-width: 0; border-bottom-width: 2px; border-color: rgba(0,0,0,0); border-radius: 0; background-color: rgba(0,0,0,0); color: var(--muted); padding: 9px 4px; font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; }
.tab.on { color: var(--fg); border-bottom-color: var(--verify); }
.tabpanel { padding: 4px 14px 12px; height: 300px; }
.alignbox { background-color: var(--raise); border-radius: 6px; padding: 8px 10px; margin: 10px 0 4px; }
.alignbox Label { font-size: 12px; color: var(--muted); }
.branch { font-size: 11px; color: var(--muted); letter-spacing: 2px; margin: 12px 0 4px; -unity-font-style: bold; }
.rs { flex-direction: row; align-items: center; padding: 7px 0; border-top-width: 1px; border-color: var(--line); }
.rs-n { -unity-font-style: bold; font-size: 13px; }
.rs-d { font-size: 12px; color: var(--muted); }
.rs-btn { margin: 0 0 0 8px; padding: 5px 9px; background-color: var(--raise); border-width: 1px; border-color: var(--line2); border-radius: 6px; color: var(--fg); font-size: 11px; }
.rs-btn:hover { border-color: var(--verify); }
.rs-btn:disabled { opacity: 0.45; }
.rs-state { font-size: 11px; -unity-font-style: bold; margin-left: 8px; }
.prog { height: 4px; background-color: var(--raise); border-radius: 2px; margin-top: 4px; }
.prog-fill { height: 4px; background-color: var(--verify); border-radius: 2px; }
.logline { flex-direction: row; margin-top: 7px; }
.logline-day { width: 46px; flex-shrink: 0; font-size: 11px; color: var(--dim); }
.logline-text { flex-grow: 1; flex-shrink: 1; font-size: 13px; }
.log-counter, .log-log { color: var(--threat); }
.log-trait { color: var(--fg); }
.log-insight { color: var(--verify); }
.guide Label { margin-top: 6px; font-size: 13px; color: var(--muted); }
.dossier { border-width: 1px; border-color: #5a2f2b; border-radius: 6px; padding: 10px; margin: 12px 0 10px; }
.dossier Label { font-size: 12px; }
.textbtn { background-color: rgba(0,0,0,0); border-width: 1px; border-color: var(--line2); border-radius: 6px; color: var(--muted); padding: 6px 10px; font-size: 12px; margin: 0; }
.textbtn:hover { color: var(--fg); }
.globalkill { padding: 12px 14px; margin-top: 10px; }
.killbtn { margin: 0 0 6px 0; padding: 9px; background-color: rgba(0,0,0,0); border-width: 1px; border-color: var(--threat); border-radius: 6px; color: var(--threat); -unity-font-style: bold; letter-spacing: 3px; font-size: 13px; }
.killbtn.armed { background-color: var(--threat); color: var(--ink-on-threat); }
.killbtn:disabled { opacity: 0.4; }

/* Haber bandı */
.news { height: 170px; flex-shrink: 0; }
.ticker { flex-direction: row; align-items: center; padding: 9px 14px; border-bottom-width: 1px; border-color: var(--line); }
.live { background-color: var(--threat); color: var(--ink-on-threat); font-size: 11px; -unity-font-style: bold; letter-spacing: 2px; padding: 2px 7px; border-radius: 4px; margin-right: 12px; }
.tick-text { flex-grow: 1; flex-shrink: 1; font-size: 15px; -unity-font-style: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tick-agency { font-size: 12px; color: var(--muted); margin-left: 12px; }
.headlines { flex-direction: row; flex-wrap: wrap; padding: 0 14px; }
.hl { width: 49%; flex-direction: row; align-items: center; padding: 5px 0; border-top-width: 1px; border-color: var(--line); margin-right: 1%; }
.hl-day { width: 54px; flex-shrink: 0; font-size: 11px; color: var(--dim); }
.hl-text { flex-grow: 1; flex-shrink: 1; font-size: 13px; }
.hl-ag { font-size: 11px; color: var(--muted); }
.hl-btn { margin: 0 0 0 8px; padding: 3px 7px; background-color: rgba(0,0,0,0); border-width: 1px; border-color: var(--line2); border-radius: 5px; color: var(--verify); font-size: 11px; }
.verdict { font-size: 11px; -unity-font-style: bold; letter-spacing: 1px; margin-left: 8px; }

/* Pencereler */
.overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(4, 8, 10, 0.84); align-items: center; justify-content: center; color: var(--fg); font-size: 14px; }
.modal { width: 640px; max-width: 94%; background-color: var(--panel); border-width: 1px; border-color: var(--line2); border-radius: 10px; padding: 24px; }
.modal > * { margin-bottom: 12px; }
.modal-title { font-size: 30px; -unity-font-style: bold; }
.eyebrow { font-size: 11px; color: var(--muted); letter-spacing: 2px; }
.brief Label { font-size: 13px; color: var(--muted); margin-top: 4px; }
.typepick { flex-direction: row; justify-content: space-between; }
.typecard { width: 32%; margin: 0; padding: 10px 12px; background-color: var(--raise); border-width: 1px; border-color: var(--line2); border-radius: 8px; -unity-text-align: upper-left; color: var(--fg); }
.typecard.on { border-color: var(--threat); background-color: #2a1f20; }
.typecard-diff { font-size: 10px; color: var(--muted); letter-spacing: 2px; }
.typecard-name { font-size: 16px; -unity-font-style: bold; }
.typecard-blurb { font-size: 12px; color: var(--muted); }
.intercept { border-width: 1px; border-color: #6b3530; border-radius: 6px; padding: 10px 14px; background-color: #1a1616; }
.intercept-lab { font-size: 11px; color: var(--muted); letter-spacing: 2px; margin-bottom: 6px; }
.intercept-line { color: var(--threat); font-size: 13px; margin-top: 3px; }
.choice { flex-direction: row; justify-content: space-between; }
.choice-btn { width: 32%; margin: 0; padding: 10px 12px; background-color: var(--raise); border-width: 1px; border-color: var(--line2); border-radius: 8px; -unity-text-align: upper-left; color: var(--fg); }
.choice-btn:hover { border-color: var(--verify); }
.choice-btn:disabled { opacity: 0.45; }
.primary { align-self: flex-start; background-color: var(--fg); color: var(--bg); border-width: 0; border-radius: 6px; padding: 10px 18px; -unity-font-style: bold; letter-spacing: 3px; font-size: 14px; margin: 0; }
.endstats { flex-direction: row; justify-content: space-between; }
.endstat { width: 24%; background-color: var(--raise); border-radius: 6px; padding: 8px 10px; }
.endstat-k { font-size: 10px; color: var(--muted); letter-spacing: 1px; }
.endstat-v { font-size: 18px; -unity-font-style: bold; }
.endchart { height: 230px; }
.end-win { color: var(--good); }
.end-bitter { color: var(--warn); }
.end-loss { color: var(--threat); }
.fakewin { border-color: var(--good); align-items: center; }
.fakewin .modal-title { color: var(--good); font-size: 52px; letter-spacing: 12px; }
.glitching { translate: -6px 2px; rotate: 1deg; border-color: var(--threat); }
.veil .modal-title { color: var(--verify); }
.toast { color: var(--fg); position: absolute; bottom: 20px; left: 30%; right: 30%; background-color: var(--raise); border-width: 1px; border-color: var(--line2); border-left-width: 3px; border-left-color: var(--warn); border-radius: 6px; padding: 10px 14px; -unity-text-align: middle-center; opacity: 0; transition-property: opacity; transition-duration: 0.2s; }
.toast.on { opacity: 1; }
.toast.ok { border-left-color: var(--verify); }
