 "regionShader": {
  "levelSource": "Bölgenin küresinin GÖRÜNEN (yumuşatılmış) düzeyi — küre ile bölge boyası aynı anda değişir. lv += (hedef − lv)·min(1, dt·3).",
  "dotMatrix": {
   "tile": "art/textures/tx_fx_land_dot_7.png",
   "periodPx": 7,
   "dotRadiusPx": 1.05,
   "color": "aiColor(lv)",
   "alpha": ".26 + .30·s  (s = lv/100)",
   "clip": "bölge çokgeni"
  },
  "glow": {
   "type": "radyal geçiş, merkez = düğüm, yarıçap = glowRadius",
   "stops": [
    [
     0,
     "a0"
    ],
    [
     0.45,
     "a0 × 0.38"
    ],
    [
     1,
     0
    ]
   ],
   "a0": ".20 + .40·s",
   "color": "aiColor(lv)",
   "clip": "bölge çokgeni",
   "blend": "normal (alfa) — kara zemininin üstüne"
  },
  "unknown": {
   "when": "infiltration = null ya da trust = unknown",
   "glow": "yok",
   "dotMatrix": {
    "color": "#7FA3B3",
    "radiusPx": 0.9,
    "alpha": 0.3
   },
   "hatch": {
    "tile": "art/textures/tx_fx_unk_hatch.png",
    "periodPx": 8.485,
    "angleDeg": 45,
    "lineWidthPx": 1,
    "color": "#7FA3B3",
    "alpha": 0.16
   }
  },
  "quarantine": {
   "pattern": {
    "tile": "art/textures/tx_fx_quar_hex.png",
    "tilePx": [
     13.856,
     24
    ],
    "color": "#3DFFB4",
    "alpha": 0.22,
    "lineWidthPx": 1
   },
   "outline": "layers.quarOutline",
   "orb": "küre türü quar (nane kafes, dönüş × 0,45)"
  },
  "orderInsideRegion": [
   "glow (ya da hatch)",
   "dotMatrix",
   "quarantine pattern"
  ],
  "glowRadiusPx": {
   "KA": 400,
   "OA": 160,
   "GA": 320,
   "BA": 260,
   "DA": 170,
   "ODKA": 250,
   "SAA": 300,
   "AV": 470,
   "GuA": 170,
   "DoA": 240,
   "GDA": 230,
   "OK": 260
  },
  "implementation": "Tek shader (UI, alfa karışım). Mesh: Sade üçgenleri; UV0 = tasarım px konumu. Parça: dot = tex(land_dot, pos/7).a; glow = parçalı doğrusal (d/R: 0→a0, .45→a0·.38, 1→0), d = |pos − node|. Çıktı: glow ve nokta üst üste (önce glow). Renk, alfalar, düğüm ve R materyal özelliği (MaterialPropertyBlock değil — UI'da bölge başına materyal örneği ya da vertex rengi + UV1). Düzey değişince yalnız özellikler güncellenir."
 },
