    - target: {fileID: 1103153848680228617, guid: c55ca66387b88471ebfa3f1450ef8fac, type: 3}
      propertyPath: m_text
      value: "e\u015Fik 15"
      objectReference: {fileID: 0}
    - target: {fileID: 1103153848680228617, guid: c55ca66387b88471ebfa3f1450ef8fac, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4281614150
      objectReference: {fileID: 0}
    - target: {fileID: 1103153848680228617, guid: c55ca66387b88471ebfa3f1450ef8fac, type: 3}
