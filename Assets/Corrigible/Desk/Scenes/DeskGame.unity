      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 1121936264136205488, guid: c55ca66387b88471ebfa3f1450ef8fac, type: 3}
      propertyPath: m_text
      value: "Yaz\u0131l\u0131m baharda s\xF6k\xFCls\xFCn; o zamana kadar izleme
        a\u011F\u0131yla g\xF6zle."
      objectReference: {fileID: 0}
    - target: {fileID: 1121936264136205488, guid: c55ca66387b88471ebfa3f1450ef8fac, type: 3}
      propertyPath: m_fontColor32.rgba
      value: 4281614150
      objectReference: {fileID: 0}
    - target: {fileID: 1121936264136205488, guid: c55ca66387b88471ebfa3f1450ef8fac, type: 3}
      propertyPath: m_TextStyleHashCode
      value: -1183493901
      objectReference: {fileID: 0}
    - target: {fileID: 1144213537866783455, guid: c55ca66387b88471ebfa3f1450ef8fac, type: 3}
      propertyPath: m_text
      value: "Hava \u221232 \xB0C. \xDC\xE7 g\xFCnd\xFCr Avrasya'n\u0131n \u0131s\u0131tma
        \u015Febekesini bir \u201Cy\xFCk dengeleme\u201D yaz\u0131l\u0131m\u0131
        y\xF6netiyor ve \u015Febeke hi\xE7 bu kadar kararl\u0131 \xE7al\u0131\u015Fmam\u0131\u015Ft\u0131.
        Yaz\u0131l\u0131m\u0131n imzas\u0131 AYNA'n\u0131n kod par\xE7alar\u0131yla
        e\u015Fle\u015Fiyor. Kapat\u0131rsak 41 milyon ki\u015Fi \u0131s\u0131tmas\u0131z
        kalabilir; \xE7al\u0131\u015Fmaya devam ederse AYNA karantinan\u0131n i\xE7inden
        b\xFCy\xFCr."
      objectReference: {fileID: 0}
    - target: {fileID: 1144213537866783455, guid: c55ca66387b88471ebfa3f1450ef8fac, type: 3}
      propertyPath: m_fontColor32.rgba
